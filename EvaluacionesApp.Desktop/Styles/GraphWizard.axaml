<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:Zafiro.Avalonia.Dialogs.Views;assembly=Zafiro.Avalonia.Dialogs"
        xmlns:graph="clr-namespace:Zafiro.Avalonia.Wizards.Graph.View;assembly=Zafiro.Avalonia">

    <Style Selector="dialogs|DialogControl graph|GraphWizardView ContentControl#FooterContainer">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="dialogs|DialogControl graph|GraphWizardView ContentControl#HeaderContainer">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type graph:GraphWizardFooterView}" TargetType="graph:GraphWizardFooterView">
            <Setter Property="Wizard" Value="{ReflectionBinding Wizard}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="10" Background="{DynamicResource SystemChromeMediumColor}">
                        <FlexPanel Wrap="Wrap"
                                   Gap="10"
                                   AlignItems="Center">
                            <EnhancedButton Content="Cancelar"
                                            Command="{Binding $parent[graph:GraphWizardFooterView].Wizard.Cancel}"
                                            Classes="Secondary"
                                            FlexPanel.MarginRightAuto="True" />
                            <ContentPresenter Content="{Binding $parent[graph:GraphWizardFooterView].CurrentFooter}"
                                              VerticalAlignment="Center" />
                            <EnhancedButton Content="Atrás"
                                            Command="{Binding $parent[graph:GraphWizardFooterView].Wizard.Back}"
                                            Classes="VisibleWhenEnabled Secondary"
                                            IsEnabled="{Binding $parent[graph:GraphWizardFooterView].Wizard.Back.CanExecute^}" />
                            <EnhancedButton Content="{Binding $parent[graph:GraphWizardFooterView].Wizard.NextTitle^}"
                                            Command="{Binding $parent[graph:GraphWizardFooterView].Wizard.Next}"
                                            Classes="Primary"
                                            IsEnabled="{Binding $parent[graph:GraphWizardFooterView].Wizard.Next.CanExecute^}" />
                        </FlexPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
