<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Views.Maintenance.StudentsView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Views.Maintenance"
             x:DataType="vm:StudentsViewModel">
  <Grid RowDefinitions="Auto, *" ColumnDefinitions="2*,3*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox Width="220" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox Width="180" ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Add" Command="{Binding AddStudent}" Margin="12,0,0,0"/>
      <Button Content="Delete" Command="{Binding DeleteStudent}"/>
      <Button Content="Mover a clase"
              Margin="12,0,0,0"
              IsEnabled="{Binding HasSelectedStudents}">
        <Button.Flyout>
          <controls:MenuFlyout ItemsSource="{Binding CourseMoveTargets}">
            <controls:MenuFlyout.ItemTemplate>
              <DataTemplate x:DataType="vm:CourseMoveTarget">
                <controls:MenuItem Header="{Binding CourseName}"
                                   ItemsSource="{Binding Classes}">
                  <controls:MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassMoveTarget">
                      <controls:MenuItem Header="{Binding ClassName}"
                                         Command="{Binding $parent[UserControl].DataContext.MoveStudents}"
                                         CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </controls:MenuItem.ItemTemplate>
                </controls:MenuItem>
              </DataTemplate>
            </controls:MenuFlyout.ItemTemplate>
          </controls:MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
    <ListBox Grid.Row="1" Grid.Column="0"
             ItemsSource="{Binding SelectedClass.Students}"
             SelectedItem="{Binding SelectedStudent}"
             SelectionMode="Multiple"
             Selection="{Binding StudentsSelection}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding FullName}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8">
      <TextBlock Text="Student details" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Nombre:" VerticalAlignment="Center"/>
        <TextBox Width="160" Text="{Binding SelectedStudent.FirstName}"/>
        <TextBlock Text="Apellidos:" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBox Width="240" Text="{Binding SelectedStudent.LastName}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Positivos:" VerticalAlignment="Center"/>
        <controls:NumericUpDown Width="120"
                                Minimum="0"
                                Increment="1"
                                Value="{Binding SelectedStudent.Positivos}"/>
        <TextBlock Text="Negativos:" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <controls:NumericUpDown Width="120"
                                Minimum="0"
                                Increment="1"
                                Value="{Binding SelectedStudent.Negativos}"/>
      </StackPanel>
      <TextBlock Text="Observaciones:"/>
      <TextBox Text="{Binding SelectedStudent.Observaciones}"
               AcceptsReturn="True"
               Height="120"
               TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
