<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Views.Maintenance.CoursesView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Views.Maintenance"
             x:DataType="vm:CoursesViewModel">
  <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button Content="Add Course" Command="{Binding AddCourse}"/>
    </StackPanel>
    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8">
      <TextBlock Text="Course details" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Name:" VerticalAlignment="Center"/>
        <TextBox Width="240" Text="{Binding SelectedCourse.Name}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Number:" VerticalAlignment="Center"/>
        <controls:NumericUpDown Width="120"
                                Minimum="1"
                                Maximum="1000"
                                Increment="1"
                                Value="{Binding SelectedCourse.Number}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
