<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Criteria"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="340"
             x:Class="EvaluacionesApp.Desktop.Features.Criteria.Views.CriteriaQuickSetupView"
             x:DataType="vm:CriteriaQuickSetupViewModel"
             Padding="20">
    <Design.DataContext>
        <vm:CriteriaQuickSetupViewModel CriteriaText="Trabajo diario&#x0a;Examen&#x0a;Proyecto" />
    </Design.DataContext>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Criterios:" Margin="0,0,0,8" />
        <TextBox Text="{Binding CriteriaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextInputOptions.ContentType="Normal"
                 TextInputOptions.Multiline="True"
                 TextInputOptions.ReturnKeyType="Return"
                 PlaceholderText="Trabajo diario"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinWidth="420"
                 MinHeight="200" />
    </DockPanel>
</UserControl>
