<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Features.Criteria.CriteriaView"
             x:Name="CriteriaViewRoot"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Criteria"
             x:DataType="vm:CriteriaViewModel">
  <UserControl.Resources>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto, *" ColumnDefinitions="2*,3*">
    <FlexPanel Grid.ColumnSpan="2" Wrap="Wrap" Gap="8" Margin="8" AlignItems="Center">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox Width="220" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Trimestre:" VerticalAlignment="Center"/>
      <ComboBox Width="120" ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}"/>
      <EnhancedButton Content="Añadir criterio principal" Command="{Binding AddRootCriterion}"/>
      <EnhancedButton Content="Añadir subcriterio" Command="{Binding AddChildCriterion}"/>
      <EnhancedButton Content="Eliminar" Command="{Binding DeleteCriterion}"/>
      <EnhancedButton Content="Crear criterios"
                      Command="{Binding CreateCriteria}"
                      IsVisible="{Binding HasNoCriteriaForSelectedTerm}"/>
      <EnhancedButton Content="Copiar criterios">
        <Button.Flyout>
          <MenuFlyout ItemsSource="{Binding CopyFeature.CopyCriteriaMenu}" ItemContainerTheme="{StaticResource MenuViewMenuItem}" />
        </Button.Flyout>
      </EnhancedButton>
    </FlexPanel>
    <Panel Grid.Row="1" Grid.Column="0">
      <TreeView ItemsSource="{Binding Criteria}"
                SelectedItem="{Binding SelectedNode}"
                IsVisible="{Binding !HasNoCriteriaForSelectedTerm}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}"/>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <StackPanel Margin="8"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasNoCriteriaForSelectedTerm}">
        <TextBlock Text="Sin criterios para este trimestre"/>
        <EnhancedButton Content="Crear criterios" Command="{Binding CreateCriteria}"/>
      </StackPanel>
    </Panel>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8">
      <TextBlock Text="Datos del criterio" FontWeight="Bold"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <TextBlock Text="Nombre:" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Grid.Column="1"
                 TextInputOptions.ContentType="Normal"
                 TextInputOptions.ReturnKeyType="Next"
                 Text="{Binding SelectedNode.Criterion.Name}"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <TextBlock Text="Peso:" VerticalAlignment="Center"/>
        <TextBox x:Name="WeightTextBox" Grid.Column="1"
                 TextInputOptions.ContentType="Number"
                 TextInputOptions.ReturnKeyType="Done"
                 Text="{Binding SelectedNode.Criterion.Weight}"/>
      </Grid>
      <TextBlock Text="No se permite borrar un criterio con subcriterios."/>
    </StackPanel>
  </Grid>
</UserControl>
