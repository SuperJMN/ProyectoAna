<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Features.Criteria.CriteriaView"
             x:Name="CriteriaViewRoot"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Criteria"
             x:DataType="vm:CriteriaViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <FlexPanel Direction="Column"
               Gap="12"
               Margin="8"
               AlignItems="Stretch">
      <FlexPanel Wrap="Wrap"
                 Gap="8"
                 AlignItems="Center">
        <TextBlock Text="Curso:" VerticalAlignment="Center"/>
        <ComboBox MinWidth="180"
                  MaxWidth="280"
                  FlexPanel.Grow="1"
                  FlexPanel.Basis="180"
                  ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedCourse}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Trimestre:" VerticalAlignment="Center"/>
        <ComboBox MinWidth="120"
                  FlexPanel.Basis="120"
                  ItemsSource="{Binding Terms}"
                  SelectedItem="{Binding SelectedTerm}"/>
      </FlexPanel>

      <FlexPanel Wrap="Wrap"
                 Gap="8"
                 AlignItems="Center">
        <EnhancedButton Content="Añadir criterio"
                        Icon="{Icon mdi-plus-circle-outline}"
                        Classes="Primary"
                        Command="{Binding AddRootCriterion}"
                        IsVisible="{Binding ShowAddRootCriterionAction}"/>
        <EnhancedButton Content="Subcriterio"
                        Icon="{Icon mdi-playlist-plus}"
                        Classes="Secondary"
                        Command="{Binding AddChildCriterion}"
                        IsVisible="{Binding ShowAddChildCriterionAction}"/>
        <EnhancedButton Content="Copiar criterios"
                        Icon="{Icon mdi-content-copy}"
                        Classes="Secondary"
                        IsVisible="{Binding ShowCopyCriteriaAction}">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding CopyFeature.CopyCriteriaMenu}" ItemContainerTheme="{StaticResource MenuViewMenuItem}" />
          </Button.Flyout>
        </EnhancedButton>
        <EnhancedButton Content="Eliminar"
                        Icon="{Icon mdi-delete-outline}"
                        Classes="Destructive"
                        Command="{Binding DeleteCriterion}"
                        IsVisible="{Binding ShowDeleteCriterionAction}"/>
      </FlexPanel>

      <BootstrapGridPanel MaxColumns="12"
                          Gutter="12"
                          FluidContainer="True">
        <Card Header="Criterios del trimestre"
              BootstrapGridPanel.Col="12"
              BootstrapGridPanel.ColLg="5">
          <Panel MinHeight="260">
            <TreeView ItemsSource="{Binding Criteria}"
                      SelectedItem="{Binding SelectedNode}"
                      IsVisible="{Binding !HasNoCriteriaForSelectedTerm}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Name}"/>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <FlexPanel Direction="Column"
                       Margin="12"
                       Gap="12"
                       AlignItems="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasNoCriteriaForSelectedTerm}">
              <TextBlock Text="Sin criterios para este trimestre"
                         TextAlignment="Center"/>
              <TextBlock Text="Crea una estructura inicial para empezar a evaluar esta parte del curso."
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360"/>
              <EnhancedButton Content="Crear criterios"
                              Icon="{Icon mdi-playlist-plus}"
                              Classes="Primary"
                              Command="{Binding CreateCriteria}"
                              IsVisible="{Binding ShowCreateCriteriaAction}"/>
            </FlexPanel>
          </Panel>
        </Card>

        <Card Header="Datos del criterio"
              IsVisible="{Binding HasSelectedCriterion}"
              BootstrapGridPanel.Col="12"
              BootstrapGridPanel.ColLg="7">
          <FlexPanel Direction="Column"
                     Gap="10"
                     AlignItems="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Nombre:" VerticalAlignment="Center"/>
              <TextBox x:Name="NameTextBox" Grid.Column="1"
                       TextInputOptions.ContentType="Normal"
                       TextInputOptions.ReturnKeyType="Next"
                       Text="{Binding SelectedNode.Criterion.Name}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Peso:" VerticalAlignment="Center"/>
              <TextBox x:Name="WeightTextBox" Grid.Column="1"
                       TextInputOptions.ContentType="Number"
                       TextInputOptions.ReturnKeyType="Done"
                       Text="{Binding SelectedNode.Criterion.Weight}"/>
            </Grid>
            <TextBlock Text="No se permite borrar un criterio con subcriterios."
                       TextWrapping="Wrap"
                       IsVisible="{Binding SelectedCriterionHasChildren}"/>
          </FlexPanel>
        </Card>
      </BootstrapGridPanel>
    </FlexPanel>
  </ScrollViewer>
</UserControl>
