<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Features.Criteria.CriteriaView"
             x:Name="CriteriaViewRoot"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Criteria"
             x:DataType="vm:CriteriaViewModel">
  <UserControl.Resources>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto, *" ColumnDefinitions="2*,3*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox Width="220" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Trimestre:" VerticalAlignment="Center"/>
      <ComboBox Width="120" ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}"/>
      <Button Content="Add Root" Command="{Binding AddRootCriterion}" Margin="12,0,0,0"/>
      <Button Content="Add Child" Command="{Binding AddChildCriterion}"/>
      <Button Content="Delete" Command="{Binding DeleteCriterion}"/>
      <Button Content="Copiar criterios" Margin="12,0,0,0">
        <Button.Flyout>
          <MenuFlyout ItemsSource="{Binding CopyCriteriaMenu}" ItemContainerTheme="{StaticResource MenuViewMenuItem}" />
        </Button.Flyout>
      </Button>
    </StackPanel>
    <TreeView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedNode}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Name}"/>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8">
      <TextBlock Text="Criterion details" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Name:" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Width="240" Text="{Binding SelectedNode.Criterion.Name}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Weight:" VerticalAlignment="Center"/>
        <TextBox x:Name="WeightTextBox" Width="120" Text="{Binding SelectedNode.Criterion.Weight}"/>
      </StackPanel>
      <TextBlock Text="No se permite borrar un criterio con subcriterios o con notas."/>
    </StackPanel>
  </Grid>
</UserControl>