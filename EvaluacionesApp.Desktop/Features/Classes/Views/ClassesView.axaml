<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Features.Classes.ClassesView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Classes"
             x:DataType="vm:ClassesViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <FlexPanel Direction="Column"
               Gap="12"
               Margin="8"
               AlignItems="Stretch">
      <FlexPanel Wrap="Wrap"
                 Gap="8"
                 AlignItems="Center">
        <TextBlock Text="Curso:" VerticalAlignment="Center"/>
        <ComboBox MinWidth="180"
                  MaxWidth="280"
                  FlexPanel.Grow="1"
                  FlexPanel.Basis="180"
                  ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedCourse}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <EnhancedButton Content="Añadir clase"
                        Icon="{Icon mdi-plus-circle-outline}"
                        Classes="Primary"
                        Command="{Binding AddClass}"
                        IsVisible="{Binding ShowToolbarAddClassAction}"/>
      </FlexPanel>

      <BootstrapGridPanel MaxColumns="12"
                          Gutter="12"
                          FluidContainer="True">
        <Card Header="Clases del curso"
              BootstrapGridPanel.Col="12"
              BootstrapGridPanel.ColLg="5">
          <Panel MinHeight="260">
            <ListBox ItemsSource="{Binding SelectedCourse.Classes}"
                     SelectedItem="{Binding SelectedClass}"
                     IsVisible="{Binding ShowClassList}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <FlexPanel Direction="Column"
                       Margin="12"
                       Gap="12"
                       AlignItems="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowNoCoursesState}">
              <TextBlock Text="Sin cursos"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"/>
              <TextBlock Text="Crea un curso antes de registrar las clases."
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360"/>
            </FlexPanel>
            <FlexPanel Direction="Column"
                       Margin="12"
                       Gap="12"
                       AlignItems="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowClassesEmptyState}">
              <TextBlock Text="Este curso no tiene clases"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"/>
              <TextBlock Text="Añade la primera clase para poder completar alumnos, criterios y notas."
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360"/>
              <EnhancedButton Content="Añadir clase"
                              Icon="{Icon mdi-plus-circle-outline}"
                              Classes="Primary"
                              Command="{Binding AddClass}"/>
            </FlexPanel>
          </Panel>
        </Card>

        <Card Header="Datos de la clase"
              IsVisible="{Binding ShowClassDetails}"
              BootstrapGridPanel.Col="12"
              BootstrapGridPanel.ColLg="7">
          <FlexPanel Direction="Column"
                     Gap="10"
                     AlignItems="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Nombre:" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1"
                       TextInputOptions.ContentType="Normal"
                       TextInputOptions.ReturnKeyType="Done"
                       Text="{Binding SelectedClass.Name}"/>
            </Grid>
          </FlexPanel>
        </Card>
      </BootstrapGridPanel>
    </FlexPanel>
  </ScrollViewer>
</UserControl>
