<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.GettingStarted"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="EvaluacionesApp.Desktop.Features.GettingStarted.GettingStartedView"
             x:DataType="vm:IGettingStartedViewModel">
    <Design.DataContext>
        <vm:GettingStartedViewModelSample />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <FlexPanel Direction="Column"
                   Gap="16"
                   Margin="16"
                   AlignItems="Stretch"
                   MaxWidth="980">
            <Card Header="¡Hola!"
                  Subheader="Tu cuaderno docente para organizar cursos, clases, criterios y notas sin perder el hilo.">
                <BootstrapGridPanel MaxColumns="12"
                                    Gutter="16"
                                    FluidContainer="True">
                    <Image Source="/Assets/logo.png"
                           Stretch="Uniform"
                           MaxHeight="150"
                           HorizontalAlignment="Center"
                           BootstrapGridPanel.Col="12"
                           BootstrapGridPanel.ColMd="3" />
                    <TextBlock Text="Aquí empieza el trabajo diario: prepara tus grupos, recoge evidencias, define criterios y revisa la evaluación con una estructura clara."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               BootstrapGridPanel.Col="12"
                               BootstrapGridPanel.ColMd="9" />
                </BootstrapGridPanel>
            </Card>

            <BootstrapGridPanel MaxColumns="12"
                                Gutter="16"
                                FluidContainer="True">
                <Card Header="Primeros pasos"
                      Subheader="{Binding SetupStatus}"
                      BootstrapGridPanel.Col="12"
                      BootstrapGridPanel.ColLg="12">
                    <FlexPanel Direction="Column"
                               Gap="12"
                               AlignItems="Start">
                        <TextBlock Text="{Binding NextSetupStepTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NextSetupStepMessage}"
                                   TextWrapping="Wrap" />
                        <EnhancedButton Content="Iniciar asistente"
                                        Icon="{Icon mdi-wizard-hat}"
                                        Classes="Primary"
                                        Command="{Binding StartInitialSetup}"
                                        IsVisible="{Binding CanStartInitialSetup}" />
                        <EnhancedButton Content="{Binding NextSetupActionText}"
                                        Icon="{Icon mdi-arrow-right-circle-outline}"
                                        Classes="Primary"
                                        Command="{Binding OpenNextSetupStep}"
                                        IsVisible="{Binding !CanStartInitialSetup}" />
                    </FlexPanel>
                </Card>
            </BootstrapGridPanel>
        </FlexPanel>
    </ScrollViewer>
</UserControl>
