<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Desktop.Features.Students.StudentsView"
             x:Name="StudentsViewRoot"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Students"
             x:DataType="vm:StudentsViewModel">
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="2*,3*">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8">
            <TextBlock Text="Curso:" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox Width="180" ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Add" Command="{Binding AddStudent}" Margin="12,0,0,0" />
            <Button Content="Delete" Command="{Binding DeleteStudent}" />
            <Button Content="Mover a clase"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding StudentsSelection.SelectedItems.Count}">
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding MoveStudentsMenu}" ItemContainerTheme="{StaticResource MenuViewMenuItem}" />
                </Button.Flyout>
            </Button>
        </StackPanel>
        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding SelectedClass.Students}"
                 SelectionMode="Multiple"
                 Selection="{Binding StudentsSelection.SelectionModel}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FullName}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8" Grid.IsSharedSizeScope="True"
                    DataContext="{Binding SelectedStudent}">
            <TextBlock Text="Student details" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Nombre:" VerticalAlignment="Center" />
                <TextBox Width="160" Text="{Binding FirstName}" />
                <TextBlock Text="Apellidos:" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Width="240" Text="{Binding LastName}" />
            </StackPanel>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Updown" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Positivos:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Width="120"
                               Minimum="0"
                               Increment="1"
                               Value="{Binding Positivos}" />
                <ItemsControl Grid.Column="2" ItemsSource="{Binding PositivosRange}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Text="⭐" FontSize="16" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Updown" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Negativos:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Width="120"
                               Minimum="0"
                               Increment="1"
                               Value="{Binding Negativos}" />
                <ItemsControl Grid.Column="2" ItemsSource="{Binding NegativosRange}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Text="💩" FontSize="16" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <TextBlock Text="Observaciones:" />
            <TextBox Text="{Binding Observaciones}"
                     AcceptsReturn="True"
                     Height="120"
                     TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>