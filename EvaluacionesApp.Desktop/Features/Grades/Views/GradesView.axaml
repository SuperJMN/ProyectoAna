<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="EvaluacionesApp.Desktop.Features.Grades.GradesView"
             x:Name="Root"
             xmlns:vm="clr-namespace:EvaluacionesApp.Desktop.Features.Grades"
             xmlns:conv="clr-namespace:EvaluacionesApp.Desktop.Features.Grades.Converters"
             x:DataType="vm:GradesViewModel">
    <UserControl.Resources>
        <conv:CriterionAggregateConverter x:Key="CriterionAggregate" />
        <conv:HasChildrenConverter x:Key="HasChildren" />
        <conv:IsLeafConverter x:Key="IsLeaf" />
        <conv:RowCriterionToBindingConverter x:Key="RowCritToBinding" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8" Grid.ColumnSpan="2">
            <TextBlock Text="Curso:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" Width="200">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}" Width="160">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Trimestre:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}" Width="100" />
        </StackPanel>


        <Grid ColumnDefinitions="2*,Auto,3*" Margin="8">
            <DataGrid ItemsSource="{Binding ScoreRows}" SelectedItem="{Binding SelectedScoreRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="Apellidos" Binding="{Binding Student.LastName}" />
                    <DataGridTextColumn Width="*" Header="Nombre" Binding="{Binding Student.FirstName}" />
                    <DataGridTextColumn Header="Nota global" Binding="{Binding Total, StringFormat=F2}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" />

            <!-- Detalle de criterios del alumno seleccionado -->
            <DockPanel Grid.Column="2" VerticalSpacing="10" Margin="12,0,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock FontWeight="Bold" FontSize="16">
                        <TextBlock.Text>
                            <Binding ElementName="Root" Path="DataContext.SelectedScoreRow.Student.FullName"
                                     StringFormat="Alumno: {0}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Text>
                            <Binding ElementName="Root" Path="DataContext.SelectedScoreRow.Total"
                                     StringFormat="Total (ponderado): {0:F2}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <ScrollViewer>
                    <TreeView ItemsSource="{Binding CriteriaTree}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <Grid x:Name="CritGrid" ColumnDefinitions="*,Auto" Margin="4,2">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <!-- Editor solo en hojas -->
                                        <TextBox x:CompileBindings="False" Width="64"
                                                 Watermark="-"
                                                 HorizontalAlignment="Right"
                                                 IsVisible="{Binding DataContext.Children, ElementName=CritGrid, Converter={StaticResource IsLeaf}}"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.DataContext>
                                                <MultiBinding Converter="{StaticResource RowCritToBinding}">
                                                    <Binding ElementName="Root" Path="DataContext.SelectedScoreRow" />
                                                    <Binding ElementName="CritGrid" Path="DataContext" />
                                                </MultiBinding>
                                            </TextBox.DataContext>
                                        </TextBox>
                                        <!-- Valor agregado en nodos con hijos -->
                                        <TextBlock
                                            IsVisible="{Binding Children, Converter={StaticResource HasChildren}}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CriterionAggregate}">
                                                    <Binding />
                                                    <Binding ElementName="Root" Path="DataContext.SelectedScoreRow" />
                                                    <Binding ElementName="Root"
                                                             Path="DataContext.SelectedScoreRow.Total" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>