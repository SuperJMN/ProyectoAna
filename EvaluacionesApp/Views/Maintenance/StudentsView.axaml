<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EvaluacionesApp.Views.Maintenance.StudentsView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Views.Maintenance"
             x:DataType="vm:StudentsViewModel">
  <Grid RowDefinitions="Auto, *" ColumnDefinitions="2*,3*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox Width="220" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox Width="180" ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Add" Command="{Binding AddStudent}" Margin="12,0,0,0"/>
      <Button Content="Delete" Command="{Binding DeleteStudent}"/>
    </StackPanel>
    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SelectedClass.Students}" SelectedItem="{Binding SelectedStudent}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" Spacing="8">
      <TextBlock Text="Student details" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Name:" VerticalAlignment="Center"/>
        <TextBox Width="240" Text="{Binding SelectedStudent.Name}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Id:" VerticalAlignment="Center"/>
        <TextBox Width="240" Text="{Binding SelectedStudent.Id}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>