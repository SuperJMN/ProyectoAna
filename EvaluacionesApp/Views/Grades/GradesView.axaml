<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="EvaluacionesApp.Views.Grades.GradesView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Views.Grades"
             x:DataType="vm:GradesViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8" Grid.ColumnSpan="2">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" Width="200">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}" Width="160">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Trimestre:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}" Width="100"/>
    </StackPanel>

    <!-- <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SelectedCourse.Criteria}"> -->
    <!--   <ListBox.ItemTemplate> -->
    <!--     <DataTemplate> -->
    <!--       <TextBlock Text="{Binding Name}"/> -->
    <!--     </DataTemplate> -->
    <!--   </ListBox.ItemTemplate> -->
    <!-- </ListBox> -->

    <DataGrid x:Name="ScoresGrid" Grid.Row="1" Grid.Column="1" 
              ItemsSource="{Binding ScoreRows}" 
              AutoGenerateColumns="False"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
</UserControl>