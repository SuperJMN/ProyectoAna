<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="EvaluacionesApp.Views.Grades.GradesView"
             xmlns:vm="clr-namespace:EvaluacionesApp.Views.Grades"
             xmlns:c="clr-namespace:Zafiro.Avalonia.Controls;assembly=Zafiro.Avalonia"
             xmlns:slimDataGrid="clr-namespace:Zafiro.Avalonia.Controls.SlimDataGrid;assembly=Zafiro.Avalonia"
             x:DataType="vm:GradesViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8" Grid.ColumnSpan="2">
      <TextBlock Text="Curso:" VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" Width="200">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Clase:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox ItemsSource="{Binding SelectedCourse.Classes}" SelectedItem="{Binding SelectedClass}" Width="160">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Trimestre:" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}" Width="100"/>
    </StackPanel>

    <!-- <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SelectedCourse.Criteria}"> -->
    <!--   <ListBox.ItemTemplate> -->
    <!--     <DataTemplate> -->
    <!--       <TextBlock Text="{Binding Name}"/> -->
    <!--     </DataTemplate> -->
    <!--   </ListBox.ItemTemplate> -->
    <!-- </ListBox> -->

    <slimDataGrid:SlimDataGrid x:Name="ScoresGrid" Grid.Row="1" Grid.Column="1" 
                    ItemsSource="{Binding ScoreRows}"
                    Background="{DynamicResource SystemRegionColor}"
                    BorderBrush="{DynamicResource SystemChromeMediumColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HeaderBackground="#20000000"
                    Padding="10">
        <slimDataGrid:SlimDataGrid.Columns>
            <slimDataGrid:Column Header="Alumno" Binding="{Binding Student.Name}" Width="2*"/>
            <!-- Las columnas dinámicas se añadirán en code-behind -->
        </slimDataGrid:SlimDataGrid.Columns>
    </slimDataGrid:SlimDataGrid>
  </DockPanel>
</UserControl>